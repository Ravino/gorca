[Unit]
Description=gorca application identity helper
Documentation=https://github.com/Ravino/gorca/blob/main/docs/adr/0026-addon-plugin-system.md
# Started by gorca.service (Wants=). It must run OUTSIDE any user namespace: it reads
# /proc/<pid>/exe of applications, which the kernel refuses to a process in a private user
# namespace (a user unit with ProtectSystem=, PrivateTmp=, ProtectKernel*=, ProtectControlGroups=,
# ProtectClock=, PrivateUsers= or ProtectHostname= gets one). So none of those options is set here;
# everything that creates no namespace is.
PartOf=gorca.service

[Service]
Type=simple
ExecStart=%h/.local/bin/gorca --identity-helper
Restart=on-failure
RestartSec=1
TimeoutStopSec=2
# One Unix socket under %t/gorca/ and /proc reads; no network, no new privileges, no JIT.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
