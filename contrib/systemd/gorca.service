[Unit]
Description=gorca screen reader (development unit)
Documentation=https://github.com/Ravino/gorca/blob/main/docs/adr/0001-core-architecture.md
PartOf=graphical-session.target
After=graphical-session.target gorca-identity.service
# Application identity helper (see Hardening below); gorca still runs, unverified, without it.
Wants=gorca-identity.service

[Service]
Type=simple
# The extensions (the GNOME Shell policy as a WASM component) are built by `make ext` (also part
# of `make release` and `make check`) into target/release/extensions. The daemon would find that
# directory beside the binary by itself; it is named here so the unit says where they come from.
# If the directory or the component is missing, the daemon logs it and runs the native build of
# the same Shell policy (`--shell-policy=native` forces that).
ExecStart=%h/.local/bin/gorca --speech=auto --impersonate-orca --ext-dir=%h/.local/lib/gorca/extensions
# ADR-0001 17.2: do not restart after an explicit kill (e.g. an operator or OOM
# policy); restart only on crashes and non-zero exits.
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=SIGKILL
TimeoutStopSec=5

# Hardening. Deliberately NOT set: PrivateDevices (evdev/libei fallback, audio),
# PrivateNetwork/PrivateUsers (D-Bus sockets under XDG_RUNTIME_DIR), RestrictRealtime
# and MemoryDenyWriteExecute (RT scheduling, wasmtime JIT).
# In a *user* unit ProtectSystem/ProtectKernel*/ProtectControlGroups/PrivateTmp put the service in
# a user namespace of its own, and the kernel then refuses /proc/<pid>/exe and /proc/<pid>/ns/* of
# every process outside it. Application identity (ADR-0026 section 2.7) therefore comes from
# gorca-identity.service, a tiny helper outside the sandbox (this unit wants it and asks it over
# %t/gorca/identity.sock); the sandbox here stays complete.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

# Not enabled at login: the user toggles it with Super+Alt+G (tools/gorca-toggle.sh).
