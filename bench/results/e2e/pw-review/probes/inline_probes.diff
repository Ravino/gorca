+
+/// REVIEW PROBE: every Request effect the driver accepted (Ok) must eventually be answered to the
+/// policy by a Reply input; a deduplicated request is never answered.
+#[test]
+fn review_probe_deduplicated_request_gets_a_reply() {
+    let mut r = rig(vec![
+        fetch(1, BudgetClass::Prefetch),
+        fetch(1, BudgetClass::Interactive),
+    ]);
+    let issued = r.tick(HealthView::Healthy);
+    eprintln!("issued {} deduped {} first class {:?}", issued.len(), r.driver.stats().deduped, issued[0].class);
+    let f = issued[0].clone();
+    r.reply(&f, FillReply::Ok(SnapshotBatch::new(vec![node(1)])));
+    eprintln!("policy heard: {:?}", r.log());
+    assert_eq!(r.log().len(), 2, "2 requests accepted, replies delivered: {:?}", r.log());
+}
