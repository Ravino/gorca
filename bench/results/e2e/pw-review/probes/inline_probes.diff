+    /// REVIEW PROBE: a quiet app (one old event, then nothing) whose node was fetched on an
+    /// earlier visit and then renamed silently (GTK4 G-1). The revisit must be revalidated (RV-1).
+    #[test]
+    fn review_probe_quiet_app_revisit_is_revalidated() {
+        let mut f = fixture();
+        let t0 = Instant::now();
+        f.writer.invalidate(key(9), PropMask::NAME, t0); // one event long ago: seq = 1
+        // Visit 1: the Reader fetched node 1 at the current seq; the reply is in the mirror.
+        let issued_at = f.writer.seq();
+        f.writer.apply(
+            SnapshotBatch::new(vec![with_name(1, "Old", StateSet::empty())]),
+            gorca_mirror::ApplyOrigin::Reply { issued_at },
+        );
+        let _ = focus_on(&mut f, 1, t0);
+        let _ = focus_on(&mut f, 2, t0 + Duration::from_secs(2));
+        // Node 1 is renamed silently; no event, so the seq does not move. Revisit 10 s later.
+        let fx = focus_on(&mut f, 1, t0 + Duration::from_secs(10));
+        eprintln!("revisit effects: {:?}", effects_of(&fx));
+        assert!(
+            effects_of(&fx).contains(&"fetch-rv1"),
+            "revisit served from the mirror without RV-1: {:?}",
+            effects_of(&fx)
+        );
+    }
+
