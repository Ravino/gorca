+
+// ---------------------------------------------------------------------------------------------
+// M9 review probes: the off-screen frame wake (`EngineQuirks::wake_offscreen_frames`).
+
+mod probe_m9r {
+    use super::*;
+    use gorca_doc_source_atspi::source::EngineQuirks;
+
+    type Log = Arc<Mutex<Vec<(u64, u32, Instant)>>>;
+
+    struct Comp {
+        log: Log,
+        id: u64,
+    }
+
+    #[zbus::interface(name = "org.a11y.atspi.Component")]
+    impl Comp {
+        fn scroll_to(&self, kind: u32) -> bool {
+            self.log.lock().unwrap().push((self.id, kind, Instant::now()));
+            true
+        }
+    }
+
+    async fn comp(fake: &Fake, log: &Log, id: u64) {
+        for s in &fake.servers {
+            s.object_server()
+                .at(
+                    path_of(id).as_str(),
+                    Comp {
+                        log: Arc::clone(log),
+                        id,
+                    },
+                )
+                .await
+                .unwrap();
+        }
+    }
+
+    fn not_showing(fake: &Fake, id: u64) {
+        fake.tree.lock().unwrap().nodes.get_mut(&id).unwrap().state &= !(1 << 25);
+    }
+
+    async fn start_blink(fake: Fake, conn: AppConn, doc: u64) -> Browse {
+        let (_unused_tx, ev_rx) = mpsc::channel(8);
+        let mut cfg = SourceConfig::browse(gorca_model::TextUnit::Scalar, true);
+        cfg.quirks = EngineQuirks::blink(true);
+        cfg.fetch = FetchOpts {
+            text: TextPolicy::All,
+            ..fast_opts(Split::Whole)
+        };
+        let (source, _metrics) = AtspiDocSource::new(Arc::new(conn), path_of(doc), cfg, ev_rx);
+        let (sink, rx) = delta_channel(1 << 14);
+        let (req_tx, req_rx) = mpsc::channel(8);
+        let (join, _j) = join_channel(8);
+        let (events, core_events) = mpsc::channel(64);
+        let shutdown = CancellationToken::new();
+        let ctx = DocSourceCtx {
+            doc: DocId(1),
+            app: app_id(),
+            sink,
+            requests: req_rx,
+            events: core_events,
+            join,
+            shutdown: shutdown.clone(),
+            clock: Clock::System,
+        };
+        let task = tokio::spawn(Box::new(source).attach(ctx));
+        Browse {
+            fake,
+            rx,
+            events,
+            requests: req_tx,
+            shutdown,
+            task,
+        }
+    }
+
+    /// An article whose first screen has no link, button or list item (only a heading and a
+    /// paragraph) and an embedded cross-site frame further down: the frame is scrolled into
+    /// view, and the page must be scrolled back.
+    #[tokio::test]
+    async fn probe_m9r_frame_wake_scrolls_the_page_back() {
+        let (fake, conn) = Fake::start(2).await;
+        let log: Log = Arc::default();
+        let doc = fake.node(raw::DOCUMENT_WEB, "page", "body", None).await;
+        let h = fake.node(raw::HEADING, "Title", "h1", None).await;
+        let p = fake.node(raw::PARAGRAPH, "", "p", None).await;
+        let fr = fake.node(28, "Video", "iframe", None).await;
+        fake.link(doc, h);
+        fake.link(doc, p);
+        fake.link(doc, fr);
+        fake.set_text(h, "Title");
+        fake.set_text(p, "Some text.");
+        not_showing(&fake, fr);
+        for id in [doc, h, p, fr] {
+            comp(&fake, &log, id).await;
+        }
+        let mut b = start_blink(fake, conn, doc).await;
+        let _ = until_settled(&mut b).await;
+        tokio::time::sleep(Duration::from_millis(1500)).await;
+        let calls: Vec<(u64, u32)> = log.lock().unwrap().iter().map(|(i, k, _)| (*i, *k)).collect();
+        b.shutdown.cancel();
+        let _ = b.task.await;
+        assert!(calls.contains(&(fr, 6)), "the frame was scrolled into view: {calls:?}");
+        assert!(
+            calls.len() >= 2,
+            "the page was scrolled to the frame and never scrolled back: {calls:?}"
+        );
+    }
+
+    /// The document closes (navigation) right after its build: the frame wake must stop with it.
+    #[tokio::test]
+    async fn probe_m9r_frame_wake_stops_with_the_source() {
+        let (fake, conn) = Fake::start(2).await;
+        let log: Log = Arc::default();
+        let doc = fake.node(raw::DOCUMENT_WEB, "page", "body", None).await;
+        let mut frames = Vec::new();
+        for i in 0..4 {
+            let fr = fake.node(28, &format!("Ad {i}"), "iframe", None).await;
+            fake.link(doc, fr);
+            not_showing(&fake, fr);
+            comp(&fake, &log, fr).await;
+            frames.push(fr);
+        }
+        let mut b = start_blink(fake, conn, doc).await;
+        let _ = until_settled(&mut b).await;
+        b.shutdown.cancel();
+        let _ = b.task.await;
+        let closed = Instant::now();
+        tokio::time::sleep(Duration::from_millis(3500)).await;
+        let after: Vec<u64> = log
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(_, _, t)| *t > closed)
+            .map(|(i, _, _)| *i)
+            .collect();
+        assert!(
+            after.is_empty(),
+            "frames of a closed document were still scrolled into view: {after:?}"
+        );
+    }
+}
