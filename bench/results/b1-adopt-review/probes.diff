+    /// Reviewer probe: a focus miss whose fetch times out after a prefetch filled the node is
+    /// presented from the cache with `revalidate == false`: no RV-1, so no protection is ever
+    /// earned for the app that really holds focus.
+    #[test]
+    fn probe_timeout_fallback_on_a_prefetched_focus_never_earns_protection() {
+        let mut f = fixture();
+        let published = Arc::new(FocusedApp::new());
+        f.reader.focused_app = Some(Arc::clone(&published));
+        let now = Instant::now();
+        let fx = focus_on(&mut f, 1, now);
+        println!("on focus: {:?}", effects_of(&fx));
+        // The prefetch window lands while the focus fetch is outstanding.
+        f.writer.apply(
+            SnapshotBatch {
+                nodes: vec![snap(1, Role::Button, "Prefetched")],
+                ..Default::default()
+            },
+            gorca_mirror::ApplyOrigin::Push,
+        );
+        let fx = f.reader.handle(
+            ReaderMsg::Reply(QueryReply {
+                node: key(1),
+                epoch: f.epoch.current(),
+                kind: FetchKind::Focus,
+                result: Err(BackendError::Timeout),
+            }),
+            now,
+        );
+        println!("on timeout: {:?} published={:?}", effects_of(&fx), published.get());
+        assert!(!effects_of(&fx).contains(&"fetch-rv1"), "no revalidation is asked");
+        assert_eq!(published.get(), None, "protection never earned (the finding)");
+    }
+
+    /// Reviewer probe: moving within the protected app onto a prefetched sibling demotes the
+    /// app until RV-1 answers; an RV-1 that times out never restores it.
+    #[test]
+    fn probe_same_app_cached_move_demotes_and_rv1_timeout_never_restores() {
+        let mut f = fixture();
+        let published = Arc::new(FocusedApp::new());
+        f.reader.focused_app = Some(Arc::clone(&published));
+        let now = Instant::now();
+        focus_on(&mut f, 1, now);
+        f.reader.handle(reply(&f, 1, FetchKind::Focus, with_name(1, "Cold", StateSet::FOCUSED)), now);
+        assert_eq!(published.get(), Some(app()), "cold fetch earns");
+        f.writer.apply(
+            SnapshotBatch { nodes: vec![snap(2, Role::Button, "Sibling")], ..Default::default() },
+            gorca_mirror::ApplyOrigin::Push,
+        );
+        let later = now + std::time::Duration::from_millis(500);
+        let fx = focus_on(&mut f, 2, later);
+        println!("cached move: {:?} published={:?}", effects_of(&fx), published.get());
+        let demoted = published.get().is_none();
+        f.reader.handle(
+            ReaderMsg::Reply(QueryReply {
+                node: key(2),
+                epoch: f.epoch.current(),
+                kind: FetchKind::Revalidate,
+                result: Err(BackendError::Timeout),
+            }),
+            later,
+        );
+        println!("after rv1 timeout published={:?}", published.get());
+        assert!(demoted, "same-app cached move demotes (the finding)");
+        assert_eq!(published.get(), None, "rv1 timeout never restores (the finding)");
+    }
