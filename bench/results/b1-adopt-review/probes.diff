+// ---- reviewer probes (b1-adopt review) ----
+
+/// R-1: walking backwards (Up arrow) the look-ahead never covers the siblings the user reaches
+/// next; a silently renamed row behind the focus is not re-read, one ahead of it is.
+#[test]
+fn probe_backward_walk_gets_no_lookahead() {
+    let mut r = Rig::new(40, false);
+    r.focus_on(row(20));
+    r.advance(600);
+    r.writer.invalidate(key(row(19)), PropMask::NAME, r.now);
+    r.writer.invalidate(key(row(21)), PropMask::NAME, r.now);
+    r.advance(30);
+    r.focus_on(row(20));
+    println!("lookaheads: {:?}", r.lookaheads(PANEL));
+    println!("row19 hit={} row21 hit={}", hit(&r, row(19)), hit(&r, row(21)));
+    assert!(hit(&r, row(21)), "ahead is re-read");
+    assert!(!hit(&r, row(19)), "behind is NOT re-read (the finding)");
+}
+
+/// R-2: a ChildrenChanged that arrives while the first window is in flight is forgotten: the
+/// run is installed clean from a reply that predates the change and never refetched.
+#[test]
+fn probe_children_changed_during_inflight_window_is_lost() {
+    let mut r = Rig::new(40, false);
+    r.hold = true;
+    r.focus_on(row(10));
+    let held = std::mem::take(&mut r.held);
+    assert!(!held.is_empty());
+    // Replies computed now (before the change) ...
+    let replies: Vec<_> = held.iter().map(|f| r.model.serve(&f.op)).collect();
+    // ... the list changes and says so ...
+    let newrow = r.model.add(Some(PANEL), Role::Button);
+    let kids = &mut r.model.nodes[PANEL].children;
+    let pos = kids.iter().position(|c| *c == newrow).unwrap();
+    kids.remove(pos);
+    let at = kids.iter().position(|c| *c == row(11)).unwrap();
+    kids.insert(at, newrow);
+    r.hold = false;
+    r.input(FillInput::Events(&[NodeEvent::ChildrenChanged { node: key(PANEL) }]));
+    // ... and only then do the old replies land.
+    for (f, rep) in held.into_iter().zip(replies) {
+        let cx = DriverCx { now: r.now, health: r.health, mirror: &r.reader, focus: r.focus };
+        r.driver.on_reply(&cx, &mut r.writer, f.id, f.issued_at, rep);
+    }
+    r.settle();
+    let base = r.windows(PANEL).len();
+    for _ in 0..10 {
+        r.advance(200);
+    }
+    println!("windows before={base} after={}", r.windows(PANEL).len());
+    assert_eq!(r.windows(PANEL).len(), base, "no refetch: the change was lost (the finding)");
+    r.focus_on(newrow);
+    println!("new row served from mirror before focus: {}", hit(&r, newrow));
+}
