+// ---- reviewer probes, round 2 ----
+
+/// RR-F3: the focus travels backwards (22 -> 21 -> 20); a silently renamed row behind it (19)
+/// must be re-read by the look-ahead. Passes when F-3 is fixed.
+#[test]
+fn probe_rr_backward_travel_rereads_behind() {
+    let mut r = Rig::new(40, false);
+    r.focus_on(row(22));
+    r.advance(100);
+    r.focus_on(row(21));
+    r.advance(600);
+    r.writer.invalidate(key(row(19)), PropMask::NAME, r.now);
+    r.writer.invalidate(key(row(18)), PropMask::NAME, r.now);
+    r.advance(30);
+    r.focus_on(row(20));
+    println!("lookaheads: {:?}", r.lookaheads(PANEL));
+    assert!(hit(&r, row(19)), "row behind the focus re-read on a backward walk");
+}
+
+/// RR-F4: the very FIRST window of a parent (no run yet) is in flight when the parent's
+/// ChildrenChanged arrives. Passes when the run is installed dirty and refetched.
+#[test]
+fn probe_rr_children_changed_during_first_window() {
+    let mut r = Rig::new(40, false);
+    r.hold = true;
+    r.focus_on(row(10));
+    // Serve the ancestry (and anything else) so that the first window is asked; hold it.
+    for _ in 0..4 {
+        let held = std::mem::take(&mut r.held);
+        let sib: Vec<_> = held
+            .iter()
+            .filter(|f| matches!(f.op, FillOp::Siblings { .. }))
+            .cloned()
+            .collect();
+        if !sib.is_empty() {
+            r.held = sib;
+            break;
+        }
+        for f in held {
+            let rep = r.model.serve(&f.op);
+            let cx = DriverCx { now: r.now, health: r.health, mirror: &r.reader, focus: r.focus };
+            r.driver.on_reply(&cx, &mut r.writer, f.id, f.issued_at, rep);
+        }
+        r.settle();
+    }
+    let held = std::mem::take(&mut r.held);
+    println!("held: {:?}", held.iter().map(|f| &f.op).collect::<Vec<_>>());
+    assert!(held.iter().any(|f| matches!(f.op, FillOp::Siblings { .. })));
+    let replies: Vec<_> = held.iter().map(|f| r.model.serve(&f.op)).collect();
+    let newrow = r.model.add(Some(PANEL), Role::Button);
+    let kids = &mut r.model.nodes[PANEL].children;
+    kids.pop();
+    let at = kids.iter().position(|c| *c == row(11)).unwrap();
+    kids.insert(at, newrow);
+    r.hold = false;
+    r.input(FillInput::Events(&[NodeEvent::ChildrenChanged { node: key(PANEL) }]));
+    for (f, rep) in held.into_iter().zip(replies) {
+        let cx = DriverCx { now: r.now, health: r.health, mirror: &r.reader, focus: r.focus };
+        r.driver.on_reply(&cx, &mut r.writer, f.id, f.issued_at, rep);
+    }
+    r.settle();
+    let base = r.windows(PANEL).len();
+    for _ in 0..10 {
+        r.advance(200);
+    }
+    println!("windows before={base} after={}", r.windows(PANEL).len());
+    assert!(r.windows(PANEL).len() > base, "first window's stale run refetched");
+}
+
+/// RR-F6: F-6 was fixed by clamping Siblings in the policy. Ancestry is not clamped: with a
+/// configured max_ancestry_depth below 24 the echoed op differs from the remembered one.
+/// Observe whether prefetch keeps working across many parents.
+#[test]
+fn probe_rr_small_ancestry_limit_bookkeeping() {
+    let limits = FillLimits { max_ancestry_depth: 2, ..FillLimits::default() };
+    let mut r = Rig::with_limits(60, false, PrefetchConfig::default(), limits);
+    let mut misses = 0;
+    for i in 0..60 {
+        r.advance(50);
+        if i > 0 && !hit(&r, row(i)) {
+            misses += 1;
+        }
+        r.focus_on(row(i));
+    }
+    let anc = r.count(|o| matches!(o, FillOp::Ancestry { .. }));
+    println!("misses={misses} ancestry_ops={anc} calls={}", r.calls());
+    assert!(misses <= 6, "{misses}");
+}
+
+/// RR-F3b: a long backward walk, slow enough that every step's look-ahead is due: count the
+/// steps whose look-ahead goes the wrong way (ahead of the focus in index order).
+#[test]
+fn probe_rr_backward_walk_lookahead_direction() {
+    let mut r = Rig::new(60, false);
+    r.focus_on(row(50));
+    let (mut wrong, mut right, mut none) = (0, 0, 0);
+    for i in (10..50).rev() {
+        r.advance(600);
+        let before = r.lookaheads(PANEL).len();
+        r.focus_on(row(i));
+        let la = r.lookaheads(PANEL);
+        match la.get(before..).and_then(|s| s.first()) {
+            Some((anchor, _, _)) if anchor.local.0 > key(row(i)).local.0 => wrong += 1,
+            Some(_) => right += 1,
+            None => none += 1,
+        }
+    }
+    println!("backward walk 40 steps: look-ahead behind(right)={right} ahead(wrong)={wrong} none={none}");
+    assert_eq!(wrong, 0);
+}
