# Таблица символов, русский язык. Поведение по образцу NVDA symbols.dic; названия собственные.
# Поля через табуляцию: символ, название, уровень, сохранение (см. symbols-en.dic).
@word.blank	пусто
@word.object	объект
@word.cap	заглавная
@level.none	без пунктуации
@level.some	немного
@level.most	большинство
@level.all	вся
@word.confirm	пунктуация {}
@sentence.dot	точка	all	always
@sentence.bang	восклицательный знак	all	always
@sentence.question	вопросительный знак	all	always
@phrase.semi	точка с запятой	most	always
@phrase.colon	двоеточие	most	always
@multiple.dot	заполняющие точки	all	always
@decimal.point		none	always
@decimal.comma		none	always
@inword.apostrophe	апостроф	all	norep
@negative.number	минус	none	norep
