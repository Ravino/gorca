# Курсор просмотра и навигация по объектам.

review-top = Верх
review-bottom = Низ
review-bottom-truncated = Низ, часть содержимого не показана
review-off = просмотр выключен
review-on = просмотр включён
review-simple-on = простой просмотр включён
review-simple-off = простой просмотр выключен
review-follows-focus-on = просмотр следует за фокусом
review-follows-focus-off = просмотр не следует за фокусом
review-position-lost = положение просмотра потеряно
review-not-responding = не отвечает
review-object-gone = объект исчез
review-unavailable = просмотр недоступен
review-layout-unavailable = раскладка недоступна
review-not-active = просмотр не активен
review-focus = фокус
review-cannot-move-focus = невозможно переместить фокус сюда
review-cannot-activate = невозможно активировать
review-status-bar = строка состояния
review-no-status-bar = строка состояния не найдена
nav-no-parent = Нет объемлющего объекта
nav-no-child = Нет вложенных объектов
nav-no-next = Нет следующего
nav-no-prev = Нет предыдущего
review-scrolled = прокручено
