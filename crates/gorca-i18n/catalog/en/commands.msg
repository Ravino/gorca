# Command descriptions (input help / learn mode): one id per command, `cmd-<name>`.

cmd-speech-stop = stop speech
cmd-speech-pause-toggle = pause or resume speech
cmd-speech-mode-cycle = turn speech on or off
cmd-speech-repeat-last = repeat the last spoken text
cmd-speech-ring-next = select the next voice setting
cmd-speech-ring-prev = select the previous voice setting
cmd-speech-ring-inc = increase the selected voice setting
cmd-speech-ring-dec = decrease the selected voice setting
cmd-speech-ring-inc-large = increase the selected voice setting by a large step
cmd-speech-ring-dec-large = decrease the selected voice setting by a large step
cmd-speech-rate-up = increase speech rate
cmd-speech-rate-down = decrease speech rate
cmd-speech-pitch-up = increase speech pitch
cmd-speech-pitch-down = decrease speech pitch
cmd-speech-volume-up = increase speech volume
cmd-speech-volume-down = decrease speech volume
cmd-speech-copy-last = copy the last spoken text
cmd-speech-punctuation-cycle = cycle the punctuation level
cmd-info-where-am-i = report the focused object and its surroundings; twice for details, three times to spell the name
cmd-info-window-title = report the window title; twice to spell it
cmd-info-time-date = report the time; twice for the date
cmd-info-current-line = report the current line
cmd-info-selection = report the selected text
cmd-info-formatting = report text formatting
cmd-info-status-bar = report the status bar
cmd-info-read-window = read the whole window
cmd-info-battery = report the battery state
cmd-info-focus-shortcut = report the shortcut of the focused object
cmd-info-clipboard = report the clipboard text
cmd-info-link-destination = report the link destination
cmd-info-details = report details of the object
cmd-echo-typed-chars-toggle = toggle speaking typed characters
cmd-echo-typed-words-toggle = toggle speaking typed words
cmd-echo-command-keys-toggle = toggle speaking command keys
cmd-verbosity-cycle = cycle the verbosity level
cmd-input-learn-mode-toggle = turn learn mode on or off
cmd-input-pass-next-key = send the next key to the application
cmd-input-sleep-toggle = turn sleep mode on or off for this application
cmd-settings-reload = reload the settings file and discard unsaved changes
cmd-settings-save = save the current settings
cmd-settings-report-problems = report problems found in the settings file
cmd-debug-node-info = report debug information about the focused object
cmd-debug-app-info = report debug information about the application
cmd-gorca-quit = quit the screen reader
cmd-text-say-all = read from here to the end
cmd-text-say-char = report the current character
cmd-text-say-word = report the current word
cmd-text-say-line = report the current line
cmd-text-spell-char = spell the current character
cmd-text-spell-word = spell the current word
cmd-text-spell-line = spell the current line
cmd-review-prev-line = move the review cursor to the previous line
cmd-review-cur-line = report the review line
cmd-review-next-line = move the review cursor to the next line
cmd-review-prev-word = move the review cursor to the previous word
cmd-review-cur-word = report the review word
cmd-review-next-word = move the review cursor to the next word
cmd-review-prev-char = move the review cursor to the previous character
cmd-review-cur-char = report the review character
cmd-review-next-char = move the review cursor to the next character
cmd-review-top = move the review cursor to the top
cmd-review-bottom = move the review cursor to the bottom
cmd-review-start-of-line = move the review cursor to the start of the line
cmd-review-end-of-line = move the review cursor to the end of the line
cmd-review-prev-page = move the review cursor up a page
cmd-review-next-page = move the review cursor down a page
cmd-review-say-all = read from the review cursor
cmd-review-mode-next = switch to the next review mode
cmd-review-mode-prev = switch to the previous review mode
cmd-review-to-focus = move the review cursor to the focus
cmd-review-move-focus = move the focus to the review cursor
cmd-review-activate = activate the object under the review cursor
cmd-review-start-of-selection = move the review cursor to the start of the selection
cmd-review-end-of-selection = move the review cursor to the end of the selection
cmd-review-copy-mark = mark the review start for copying
cmd-review-copy = copy from the mark to the review cursor
cmd-review-toggle = turn review mode on or off
cmd-review-caret-follows-toggle = toggle the caret following the review cursor
cmd-review-focus-follows-toggle = toggle the review cursor following the focus
cmd-review-simple-toggle = toggle simple review, which skips layout-only objects
cmd-review-above = move the review cursor to the zone above
cmd-review-below = move the review cursor to the zone below
cmd-object-current = report the current object
cmd-object-parent = move to the parent object
cmd-object-first-child = move to the first child object
cmd-object-next = move to the next object
cmd-object-prev = move to the previous object
cmd-object-next-in-flow = move to the next object in reading order
cmd-object-prev-in-flow = move to the previous object in reading order
cmd-browse-toggle = toggle between browse mode and focus mode
cmd-browse-single-letter-toggle = toggle single letter navigation
cmd-browse-elements-list = list elements of the document
cmd-browse-find = find text in the document
cmd-browse-find-next = find the next match
cmd-browse-find-prev = find the previous match
cmd-browse-refresh = refresh the document
cmd-browse-live-regions-toggle = toggle live region announcements
cmd-browse-activate = activate the object
cmd-browse-container-start = move to the start of the container
cmd-browse-container-end = move to the end of the container
cmd-browse-escape = return from focus mode to browse mode
