# Words the verbaliser and the quick commands compose messages from (formerly `@word.*` and
# `@level.*` rows of the symbol tables).

word-blank = blank
word-object = object
word-cap = cap
level-none = none
level-some = some
level-most = most
level-all = all
word-confirm = punctuation {level}
lock-caps = Caps Lock
lock-num = Num Lock
lock-scroll = Scroll Lock
lock-on = {key} on
lock-off = {key} off
history-secret = password
history-empty = no speech history
history-oldest = oldest
history-newest = newest
sleep-on = sleep mode on
sleep-off = sleep mode off
battery-none = no battery
battery-unavailable = battery status unavailable
battery-percent = {n} percent
battery-charging = charging
battery-discharging = discharging
battery-full = fully charged
battery-empty = empty
battery-pending = waiting to charge
battery-time = {dur} remaining
battery-hm = {h} h {m} min
battery-m = {m} min
