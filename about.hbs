<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>gorca third-party licences</title>
</head>
<body>
<main>
<h1>Third-party licences</h1>
<p>gorca is built with the following open source packages.</p>

<h2>Overview of licences</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

<h2>All licence texts</h2>
{{#each licenses}}
<section id="{{id}}">
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} (<a href="{{crate.repository}}">{{crate.repository}}</a>){{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</main>
</body>
</html>
