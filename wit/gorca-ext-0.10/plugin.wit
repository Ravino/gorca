package gorca:ext@0.10.0;
// SPDX-License-Identifier: MIT OR Apache-2.0

// DRAFT (paper only, ADR-0026 r2 §2.3). Interfaces a plugin exports, and the worlds.
//
// Lanes (ADR-0026 §2.4): the host keeps up to two instances of a component per scope:
//   W (writer lane): runs `rules.*` in the node writer's turn (app actor or document actor;
//     placement decided by the C-3 bake-off, ADR-0026 §5) under a fuel grant and a wall-clock
//     check. Reads the observed view only.
//   R (reader lane): runs `commands.*`, `reactor.*`, `site-hooks.*` on the extension worker,
//     and `present.*` inline on the Reader. Reads published fused values.
// The two instances share no memory; they communicate only through the model (facts the W
// instance asserts are what the R instance reads). Handles are per instance.

/// Writer lane. Facts in, facts out; no speech, no actions, no timers, no clock.
interface rules {
  use types.{node-ref, epoch, selector-id};

  /// Why a node is in a batch (registry codes, neutral names): attach (first sight at scope
  /// attach), added (new watch match), changed (an observed value in the call's read classes),
  /// structure (observed parent or children changed), text (observed text changed), rebound
  /// (anchor rebound), ttl (an inferred fact expires), epoch (settings change or reload).
  /// Never the plugin's own facts or any fused change (ADR-0026 §2.4.1).
  type cause-code = u8;

  record dirty {
    node: node-ref,
    /// The manifest `[[watch]]` selector that matched on the observed view (the core
    /// prefilters; a plugin is never called for a node no watch selector matches).
    watch: selector-id,
    cause: cause-code,
  }

  record rule-ctx {
    epoch: epoch,
    /// True when the batch is the focus chain or active descendant of a focus change (the
    /// interactive slice, ADR-0026 §2.4.2): the fuel grant is small and shared.
    interactive: bool,
  }

  /// Once per scope instance, eagerly at scope attach on the background lane (B-1 budget),
  /// followed by a `derive` of every currently watched node.
  attach: func(ctx: rule-ctx);
  /// Up to 64 dirty nodes per call. The plugin asserts or retracts facts through `facts`
  /// (at most 256 facts per call).
  derive: func(ctx: rule-ctx, batch: list<dirty>);
  /// Watched nodes that left the scope (at most 64 per call, background lane, B-1 budget);
  /// their handles are dead after this call.
  removed: func(nodes: list<node-ref>);
}

/// Reader lane: user commands bound in the manifest keymap. Third-party keymaps may bind only
/// chords with the gorca modifier and are inactive while focus is in an editable or secret
/// node (ADR-0026 KB-1..KB-4). The command id is all the plugin learns about the key.
interface commands {
  use types.{node-ref, epoch};

  record cmd-ctx {
    focus: option<node-ref>,
    cursor: option<node-ref>,
    /// Core mode code (browse, focus, review, ...).
    mode: u16,
    press-count: u8,
    epoch: epoch,
  }

  /// Limit 20 ms (B-4). Effects buffered; a key the plugin does not want is returned with
  /// `actions.pass-key`.
  run: func(id: u32, ctx: cmd-ctx);
}

/// Reader lane: completions of reader-lane requests and timers (B-5, 5 ms).
interface reactor {
  use types.{node-ref};

  variant reply {
    /// At most 64 KiB.
    text(string),
    children(list<node-ref>),
    refreshed,
    timeout,
    gone,
    denied,
  }

  deliver: func(id: u32, r: reply);
  tick: func(token: u32);
  /// Own settings changed (by the user, a profile switch, or one of this plugin's commands).
  settings-changed: func(keys: list<string>);
}

/// Reader lane, `site` world only.
interface site-hooks {
  /// SPA navigation inside a matched document (ADR-0008 amendment 3 limitation). Facts depend
  /// on the observed view, so this hook only resets plugin state; it never speaks.
  route-changed: func(url: string);
}

/// Reader lane, inline, IR-edit form of ADR-0022 §2.9. Frozen only after M22b1 freezes `PresIr`;
/// until then behind `@unstable(feature = present-edit)` (ADR-0026 §2.2, M18a-6).
interface present {
  use types.{node-ref, field-code, reason-code, text, epoch};

  record field {
    kind: field-code,
    /// Index of this field in the IR, stable within the call.
    slot: u16,
  }

  record present-ctx {
    node: node-ref,
    reason: reason-code,
    epoch: epoch,
  }

  variant ir-edit {
    drop(u16),
    replace(tuple<u16, text>),
    insert-after(tuple<u16, field-code, text>),
    move-before(tuple<u16, u16>),
  }

  /// Limit 0.1 ms per call; 0.3 ms aggregate over all plugins per utterance (B-3, fail-open).
  /// At most 32 edits, text ≤ 512 B each; a longer result is rejected before it is copied.
  edit: func(ctx: present-ctx, fields: list<field>) -> list<ir-edit>;
}

world app-module {
  import model;
  import facts;
  import output;
  import actions;
  import settings;
  import timers;
  import requests;
  import diag;

  export rules;
  export commands;
  export reactor;
  @unstable(feature = present-edit)
  export present;
}

world site {
  include app-module;
  export site-hooks;
}
