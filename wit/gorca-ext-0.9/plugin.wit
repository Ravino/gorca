package gorca:ext@0.9.0;
// SPDX-License-Identifier: MIT OR Apache-2.0

// DRAFT (paper only, ADR-0026 §2.3). Interfaces a plugin exports, and the worlds.
//
// Lanes (ADR-0026 §2.4): the host keeps up to two instances of a component per scope:
//   W (writer lane): runs `rules.*` inside the node writer (app actor or document actor),
//     synchronously, under a fuel budget, between fusion batches. Reads the observed view.
//   R (reader lane): runs `commands.*`, `reactor.*`, `site-hooks.*` on the extension worker,
//     and `present.*` inline on the Reader. Reads published fused entries.
// The two instances share no memory; they communicate only through the model (facts the W
// instance asserts are what the R instance reads).

/// Writer lane. Facts in, facts out; no speech, no actions.
interface rules {
  use types.{node-ref, snapshot-token, epoch, selector-id};

  /// Why a node is in a batch (registry codes): added, observed-change, children-changed,
  /// text-changed, rebound, refresh (after `requests.refresh`), attach (first sight).
  type cause-code = u8;

  record dirty {
    node: node-ref,
    /// The manifest `[[watch]]` selector that matched (the core prefilters; a plugin is never
    /// called for a node no watch selector matches).
    watch: selector-id,
    cause: cause-code,
  }

  record rule-ctx {
    token: snapshot-token,
    epoch: epoch,
    /// True when the batch is the focus chain or active descendant of a focus change (the
    /// interactive slice, ADR-0026 B-2): keep it short.
    interactive: bool,
  }

  /// Once per scope instance, before the first batch.
  attach: func(ctx: rule-ctx);
  /// Up to 64 dirty nodes per call. The plugin asserts or retracts facts through `facts`.
  derive: func(ctx: rule-ctx, batch: list<dirty>);
  /// Watched nodes that left the scope; their handles are dead after this call.
  removed: func(nodes: list<node-ref>);
}

/// Reader lane: user commands bound in the manifest keymap.
interface commands {
  use types.{node-ref, epoch};

  record cmd-ctx {
    focus: option<node-ref>,
    cursor: option<node-ref>,
    /// Core mode code (browse, focus, review, ...).
    mode: u16,
    press-count: u8,
    epoch: epoch,
  }

  /// Limit 20 ms CPU on the extension worker. Effects buffered; a key the plugin does not
  /// want is returned with `actions.pass-key`.
  run: func(id: u32, ctx: cmd-ctx);
}

/// Reader lane: completions.
interface reactor {
  use types.{node-ref, snapshot-token};

  variant reply {
    text(string),
    children(list<node-ref>),
    refreshed,
    timeout,
    gone,
    denied,
  }

  deliver: func(id: u32, r: reply, token: snapshot-token);
  tick: func(token: u32);
  /// Own settings changed (by the user or by a profile switch).
  settings-changed: func(keys: list<string>);
}

/// Reader lane, `site` world only.
interface site-hooks {
  use types.{snapshot-token};

  /// SPA navigation inside a matched document (ADR-0008 amendment 3 limitation). Facts depend
  /// on the observed view, so this hook only resets plugin state; it never speaks.
  route-changed: func(url: string, token: snapshot-token);
}

/// Reader lane, inline, IR-edit form of ADR-0022 §2.9. Frozen only after M22b1 freezes `PresIr`;
/// until then behind `@unstable(feature = present-edit)` (ADR-0026 §2.2, M18a-6).
interface present {
  use types.{node-ref, field-code, reason-code, text, epoch};

  record field {
    kind: field-code,
    /// Index of this field in the IR, stable within the call.
    slot: u16,
  }

  record present-ctx {
    node: node-ref,
    reason: reason-code,
    epoch: epoch,
  }

  variant ir-edit {
    drop(u16),
    replace(tuple<u16, text>),
    insert-after(tuple<u16, field-code, text>),
    move-before(tuple<u16, u16>),
  }

  /// Limit 0.2 ms CPU; 0.5 ms aggregate over all plugins per utterance (fail-open).
  edit: func(ctx: present-ctx, fields: list<field>) -> list<ir-edit>;
}

world app-module {
  import model;
  import facts;
  import output;
  import actions;
  import settings;
  import timers;
  import requests;
  import diag;

  export rules;
  export commands;
  export reactor;
  @unstable(feature = present-edit)
  export present;
}

world site {
  include app-module;
  export site-hooks;
}
