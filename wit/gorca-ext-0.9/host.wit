package gorca:ext@0.9.0;
// SPDX-License-Identifier: MIT OR Apache-2.0

// DRAFT (paper only, ADR-0026 §2.3). Interfaces the host provides. Every function here is
// non-blocking and in-memory: none performs IPC. IPC is `requests.request` + `reactor.deliver`.
// A call without the permission it needs returns `none`/empty (reads) or is dropped and counted
// (effects); it is not a fault (ADR-0026 §2.5.3).

/// Read access to the semantic model of the plugin's scope.
///
/// Lane rule (ADR-0026 §2.3.2): in the writer lane (`rules.*`) reads return the OBSERVED view
/// (stratum S0 after quirks, plus structure and cached text): never patch, user, derived or
/// inferred values, so a plugin's facts are a function of observed data and cannot feed back
/// into themselves. In the reader lane (`commands`, `reactor`, `present`) reads return the
/// PUBLISHED fused entries (`Ivm::entry_view`, silenced sources masked).
interface model {
  use types.{node-ref, role-code, group-code, prop-value, view-node, prov-info, selector-id,
             app-info};

  app: func() -> app-info;
  /// Document URL of a `site` scope, as matched by the manifest (none in `app-module`).
  doc-url: func() -> option<string>;
  /// Reader lane: the focused node of this scope, if any.
  focus: func() -> option<node-ref>;
  /// Reader lane: the browse or review cursor's node of this scope, if any.
  cursor: func() -> option<node-ref>;

  role: func(n: node-ref) -> option<role-code>;
  /// `none` = Unknown; `some(absent)` = fetched, no value.
  prop: func(n: node-ref, group: group-code) -> option<prop-value>;
  name: func(n: node-ref) -> option<string>;
  /// Registry state bits (focused, selected, editable, ...).
  states: func(n: node-ref) -> u64;
  parent: func(n: node-ref) -> option<node-ref>;
  children: func(n: node-ref, max: u16) -> list<node-ref>;
  /// One boundary crossing for a bounded subtree, depth first (at most 256 nodes, depth 8).
  subtree: func(root: node-ref, max-depth: u8, max-nodes: u16) -> list<view-node>;
  /// Cached text only (never an IPC); `none` when not cached. Needs `read-text`.
  text: func(n: node-ref, start: u32, len: u32) -> option<string>;
  /// Raw toolkit or web attribute (tag, class, id, xml-roles, ...), clipped to 256 bytes.
  /// Needs `read-attributes`. Keys are lowercase; unknown keys return none.
  attr: func(n: node-ref, key: string) -> option<string>;
  /// Evaluate a manifest selector natively in the core (ADR-0019 §4.4).
  matches: func(n: node-ref, sel: selector-id) -> bool;
  select: func(root: node-ref, sel: selector-id, max: u16) -> list<node-ref>;
  /// Reader lane: provenance of a published group (ADR-0024 §2.10 read side).
  prov: func(n: node-ref, group: group-code) -> option<prov-info>;
}

/// Facts the plugin contributes to the semantic model (ADR-0024 §2.10). Writer lane only; in
/// other lanes the calls are dropped and counted. Buffered: applied through `admit` after the
/// call returns, all or nothing (ADR-0019 I-3), at most 32 per call.
interface facts {
  use types.{node-ref, group-code, prop-value, selector-id, snapshot-token, category-code, rect,
             role-code};

  record dom-anchor { frame: u64, id: string, dom-count: u16 }
  record structural-anchor { path: u64, role: role-code, name: u64 }
  record region-anchor { window: u64, area: rect, capture: u64 }

  /// All cases exist in 0.9 (ADR-0024 W-1); a world that cannot use one gets `unsupported`
  /// in the diagnostics and the fact is dropped.
  variant fact-target {
    node(node-ref),
    dom-id(dom-anchor),
    structural(structural-anchor),
    region(region-anchor),
    selector(selector-id),
  }

  /// Which stratum the fact is for (ADR-0026 §2.6). `patch` is S1 (author intent, plain speech)
  /// and needs a grant for it; `inferred` is S4 (below derived, hedged by tier and confidence).
  enum layer { patch, inferred }

  /// `conf` is the plugin's calibrated precision in 1/1000 (ignored for `patch`).
  /// `ttl-ms` is required for `inferred` (the host applies 300000 when none).
  %assert: func(target: fact-target, group: group-code, value: prop-value, at: layer,
                conf: u16, basis: snapshot-token, ttl-ms: option<u32>);
  retract: func(target: fact-target, group: group-code, at: layer);
  /// Patch layer: remove from browse, quick nav and review sets (existence register).
  hide: func(target: fact-target, basis: snapshot-token);
  unhide: func(target: fact-target);
  /// Membership in a category the manifest declares (`ExtCats`, ADR-0022 §2.9).
  category: func(target: fact-target, cat: category-code, member: bool, basis: snapshot-token);
}

/// Output through the normal pipeline (ADR-0022 §2.9: declared content utterances, rendered by
/// the same render stage, epoch-tagged, rate-limited). Buffered like `facts`.
interface output {
  use types.{node-ref, text, reason-code};

  enum urgency {
    /// Only inside a command the plugin owns: interrupts current speech.
    interrupt,
    message,
    notification,
    progress,
  }

  variant part {
    text(text),
    /// Present this node through the core pipeline (compose -> PresIr -> render) for the
    /// given reason, exactly as the core would.
    node(tuple<node-ref, reason-code>),
  }

  say: func(parts: list<part>, u: urgency);
  /// A core cue name or one of the plugin's own cue theme.
  cue: func(name: string);
}

/// Acting on the application. Buffered; every call is validated by the core again at apply
/// time. Accepted only while a user command of this plugin is in flight, or in a reactor
/// delivery of a request that command issued within the same epoch (ADR-0026 AC-3).
interface actions {
  use types.{node-ref, action-code};

  enum mode { browse, focus }

  /// Needs `act`. The core maps the code to the connector's action and announces failure.
  activate: func(n: node-ref, action: action-code);
  /// Needs `act`: give the node keyboard focus.
  focus: func(n: node-ref);
  /// Needs `navigate`: move the browse or review cursor; the core speaks the node.
  move-cursor: func(n: node-ref);
  /// Needs `navigate`: below the user's toggle (ADR-0024 PS-3).
  request-mode: func(m: mode);
  /// Needs `pointer` (first-party only in 0.9) and the gorca-helper `pointer` capability:
  /// routed through the ADR-0025 click path with its occlusion and target checks.
  pointer-click: func(n: node-ref, button: u8);
  /// Inside a command: hand the key back to the application (pass-through).
  pass-key: func();
}

/// The plugin's own settings (`ext.<id>.*`, schema-validated, ADR-0019 I-8).
interface settings {
  variant setting-value {
    truth(bool),
    integer(s64),
    choice(u16),
    words(string),
  }

  get: func(key: string) -> option<setting-value>;
  /// Buffered; reader lane only.
  set: func(key: string, value: setting-value);
}

/// Timers (buffered): at least 50 ms, at most 16 armed per instance. Fire into `reactor.tick`.
interface timers {
  arm: func(token: u32, after-ms: u32);
  cancel: func(token: u32);
}

/// Asynchronous reads that may need IPC. Never blocks: returns an id at once; the reply arrives
/// in `reactor.deliver` under a host deadline (ADR-0019 I-2). At most 8 in flight per instance.
interface requests {
  use types.{node-ref};

  enum budget { interactive, prefetch, background }

  variant query {
    /// Text beyond the cache (needs `read-text`).
    text(tuple<node-ref, u32, u32>),
    /// Children not yet in the mirror.
    children(tuple<node-ref, u16>),
    /// Ask the primary source to refetch a node (bounded by the core's fetch scheduler).
    refresh(node-ref),
  }

  variant request-error { busy, denied, unsupported }

  request: func(q: query, b: budget) -> result<u32, request-error>;
  cancel: func(id: u32);
}

interface diag {
  /// Rate-limited; never contains node text unless the user enabled verbose add-on logs.
  log: func(level: u8, msg: string);
  /// Monotonic milliseconds.
  now-ms: func() -> u64;
}
