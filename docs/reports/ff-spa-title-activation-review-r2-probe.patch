+// REVIEW PROBE (not for merge): cursor placed by focus, then the node is re-used for another item.
+#[test]
+fn probe_review_swap_after_focus_placement_is_noticed() {
+    let mut r = rig();
+    r.focus(1006);
+    let mut link = src(6, Role::Link, Some(1006));
+    link.states |= StateSet::FOCUSABLE;
+    link.name = Some(Arc::from("Dave"));
+    r.tr.apply(&mut r.writer, vec![DocDelta::Upsert(vec![link, run(7, "Dave")]), DocDelta::Settled { batch: 3 }])
+        .unwrap();
+    r.writer.publish();
+    r.reader.handle(ReaderMsg::Doc(DocNotice::Changed { doc: DocId(1), rev: 3 }), r.now);
+    let fx = r.key(CoreCmd::BrowseActivate);
+    let clicked = effects_web(&fx).iter().any(|a| matches!(a, WebEffect::Act { act: DocAction::Click, .. }));
+    eprintln!("PROBE swap clicked={clicked} spoken={:?}", spoken(&fx));
