+#[test]
+fn probe_review_displaced_refusal_then_name_only_refresh() {
+    let mut r = rig();
+    probe_labelled(&mut r, "Delete message from Bob", "Delete", 2);
+    r.focus(1006);
+    assert!(click_of(&r.key(CoreCmd::BrowseActivate)));
+    // The source re-read the button: its name is now Alice's row. Refused.
+    let fx = r.reader.handle(ReaderMsg::Doc(DocNotice::ActionDisplaced { doc: DocId(1) }), r.now);
+    eprintln!("PROBE refusal said {:?}", spoken(&fx));
+    // The refresh lands: same visible text, new name.
+    probe_labelled(&mut r, "Delete message from Alice", "Delete", 3);
+    let fx2 = r.key(CoreCmd::BrowseActivate);
+    eprintln!("PROBE 2nd Enter: click={} spoken={:?}", click_of(&fx2), spoken(&fx2));
+    let fx3 = r.key(CoreCmd::BrowseActivate);
+    eprintln!("PROBE 3rd Enter: click={} spoken={:?}", click_of(&fx3), spoken(&fx3));
+}
