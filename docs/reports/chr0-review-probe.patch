+fn probe_labelled(r: &mut Rig, name: &str, text: &str, rev: u64) {
+    let mut n = src(6, Role::Button, Some(1006));
+    n.states |= StateSet::FOCUSABLE;
+    n.name = Some(Arc::from(name));
+    r.tr.apply(
+        &mut r.writer,
+        vec![DocDelta::Upsert(vec![n, run(7, text)]), DocDelta::Settled { batch: rev }],
+    )
+    .unwrap();
+    r.writer.publish();
+    r.reader.handle(ReaderMsg::Doc(DocNotice::Changed { doc: DocId(1), rev }), r.now);
+}
