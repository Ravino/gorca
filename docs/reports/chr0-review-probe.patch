+#[tokio::test]
+async fn probe_review_incremental_update_waits_behind_a_repair() {
+    let (fake, conn) = Fake::start(2).await;
+    let doc = fake.node(raw::DOCUMENT_WEB, "page", "body", None).await;
+    let p = fake.node(raw::PARAGRAPH, "", "p", None).await;
+    fake.link(doc, p);
+    fake.set_text(p, "one");
+    let mut b = start_browse(fake, conn, doc).await;
+    let _ = until_settled(&mut b).await;
+    // A slow repair (a big page): 600 ms.
+    b.fake.tree.lock().unwrap().nodes.get_mut(&p).unwrap().role_delay = Duration::from_millis(600);
+    let (reply, _repaired) = gorca_rt::oneshot::channel::<Result<gorca_doc_source_api::RepairReport, gorca_doc_source_api::SourceError>>();
+    b.requests.send(DocRequest::Repair { reply }).await.unwrap();
+    tokio::time::sleep(Duration::from_millis(20)).await;
+    // The page adds a paragraph and says so (an ordinary incremental update).
+    let q = b.fake.node(raw::PARAGRAPH, "", "p", Some("q")).await;
+    b.fake.set_text(q, "fresh");
+    b.fake.link(doc, q);
+    let t = Instant::now();
+    b.events
+        .send(DocEvent {
+            ev: NodeEvent::ChildrenChanged { node: node_key(doc) },
+            seq: 1,
+            at: Instant::now(),
+        })
+        .await
+        .unwrap();
+    let end = Instant::now() + Duration::from_secs(5);
+    let mut seen = None;
+    while Instant::now() < end {
+        if let Ok(Some(d)) = tokio::time::timeout(Duration::from_millis(20), b.rx.deltas.recv()).await {
+            if let DocDelta::Upsert(v) = &d
+                && v.iter().any(|n| n.text.as_deref() == Some("fresh"))
+            {
+                seen = Some(t.elapsed());
+                break;
+            }
+        }
+    }
+    eprintln!("PROBE incremental add visible after {seen:?} (repair in flight 600 ms)");
+    b.shutdown.cancel();
+    let _ = b.task.await;
+}
