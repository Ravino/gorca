+    #[test]
+    fn probe_review_root_state_storm_fills_ctl_and_drops_a_click() {
+        let mut r = rig();
+        let now = Instant::now();
+        let st = NodeEvent::PropertiesChanged { node: nk(11), mask: PropMask::STATES };
+        // One batch per pump; the doc actor is busy (not draining) for a moment.
+        for _ in 0..16 {
+            r.router.route(&[st.clone()], now);
+        }
+        let act = DocCtl::Act { node: DocNodeId::from_parts(1, 0), act: gorca_model::DocAction::Click };
+        let res = r.handle.ctl.try_send(act);
+        eprintln!("PROBE ctl after 16 root-state batches (cap 16 in rig): click try_send ok = {}", res.is_ok());
+        let mut n = 0;
+        while let Ok(DocCtl::Repair(_)) = r.ctl.try_recv() { n += 1; }
+        eprintln!("PROBE queued Repair ctl messages = {n}");
+    }
 }
