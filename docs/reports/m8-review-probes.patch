+    // m8-review probe (reviewer): an alert inserted after the load, in a batch that also
+    // touches >= 64 other nodes (an SPA re-render), versus the same alert alone.
+    fn alert_after_load(extra_touched: usize) -> usize {
+        let t0 = Instant::now();
+        let (d0, r) = page("idle", "polite");
+        let mut d = d0;
+        let mut t = LiveTracker::new();
+        t.on_batch(&d, &[r], t0);
+        let _ = t.tick(&d, t0 + Duration::from_millis(700));
+        let later = t0 + Duration::from_secs(5);
+        let alert = SubtreeSpec::with_children(
+            NodeSpec::new(Role::Alert).flags(NodeFlags::BLOCK),
+            vec![SubtreeSpec::leaf(NodeSpec::new(Role::StaticText).text("Payment failed"))],
+        );
+        let root = d.root().unwrap();
+        assert!(d.apply(&DocOp::InsertSubtree { parent: Some(root), before: None, subtree: Arc::new(alert) }).is_ok());
+        let a = d.children(root).last().unwrap();
+        let mut touched = vec![a];
+        touched.extend(std::iter::repeat_n(root, extra_touched));
+        t.on_batch(&d, &touched, later);
+        let mut n = 0;
+        for ms in [60u64, 250, 1000] {
+            n += t.tick(&d, later + Duration::from_millis(ms)).len();
+        }
+        n
+    }
+
+    #[test]
+    fn probe_m8r_alert_in_a_bulk_batch() {
+        eprintln!("PROBE alert alone: {} messages", alert_after_load(0));
+        eprintln!("PROBE alert + 63 other touched nodes: {} messages", alert_after_load(63));
+    }
