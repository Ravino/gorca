+
+// ---- m8-review probes (reviewer): which cursor positions get a D-2 SetCaret --------------------
+mod probe_m8r_caret {
+    use super::*;
+
+    fn acts(fx: &ReaderEffects) -> Vec<String> {
+        effects_web(fx)
+            .iter()
+            .filter_map(|w| match w {
+                WebEffect::Act { node, act, .. } => Some(format!("{act:?} on {node:?}")),
+                _ => None,
+            })
+            .collect()
+    }
+
+    fn walk(r: &mut Rig, label: &str) {
+        r.focus(1002);
+        r.now += Duration::from_millis(300);
+        let _ = r.reader.handle(ReaderMsg::Timer, r.now);
+        for (name, cmd) in [
+            ("Down (plain paragraph line)", CoreCmd::BrowseCursorNextLine),
+            ("K (link)", CoreCmd::QuicknavNextLink),
+            ("Down (heading line)", CoreCmd::BrowseCursorNextLine),
+        ] {
+            let fx = r.key(cmd);
+            r.now += Duration::from_millis(200);
+            let t = r.reader.handle(ReaderMsg::Timer, r.now);
+            eprintln!("PROBE [{label}] {name}: spoke {:?} acts {:?}", spoken(&fx), acts(&t));
+        }
+    }
+
+    #[test]
+    fn probe_m8r_caret_follow_targets() {
+        let mut r = rig();
+        walk(&mut r, "root not focusable (fixture)");
+        // Gecko's document accessible is FOCUSABLE: the same page with that state.
+        let mut r = rig();
+        let mut body = block(src(1, Role::DocumentWeb, Some(1001)));
+        body.name = Some(Arc::from("Test page"));
+        body.states |= StateSet::FOCUSABLE;
+        r.tr
+            .apply(
+                &mut r.writer,
+                vec![DocDelta::Upsert(vec![body]), DocDelta::Settled { batch: 2 }],
+            )
+            .unwrap();
+        r.writer.publish();
+        walk(&mut r, "root FOCUSABLE (as Gecko)");
+    }
+}
